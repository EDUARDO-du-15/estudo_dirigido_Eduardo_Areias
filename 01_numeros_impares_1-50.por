programa
{
	
	funcao inicio()
	{

		para(inteiro i = 0; i < 50; i++){
			se((i % 2) == 1){
				se(i != 49){
					escreva(i, " - ")
				}senao{
					escreva(i, ".")
				}
			}
		}
	}
}
